# ==============================================================================
# PinPro - Environment Variables & Secrets Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root directory or add these keys
# into the Secrets Panel in Google AI Studio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE MAPS API KEY (Required)
# ------------------------------------------------------------------------------
# Key used for Google Maps SDK, custom tile fallback rendering, and geocoding.
# Obtain a key from: https://console.cloud.google.com/google/maps-apis
MAPS_API_KEY=AIzaSyAwvm2PtYVwJvsVAiF564fBg-W0VooMCD4

# ------------------------------------------------------------------------------
# 2. FIREBASE CONFIGURATION (Optional for Production Deployments)
# ------------------------------------------------------------------------------
# Note: In Android AI Studio builds, Firebase configs are managed via google-services.json
# and firebase_applet_config.xml. These variables are for reference or web integration.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=pinpro-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pinpro-app
VITE_FIREBASE_STORAGE_BUCKET=pinpro-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890

# ------------------------------------------------------------------------------
# 3. BARANGAY DEFAULT LOCATION OVERRIDES
# ------------------------------------------------------------------------------
DEFAULT_BARANGAY_NAME=Brgy. Poblacion
DEFAULT_BARANGAY_CITY=Balanga City
DEFAULT_BARANGAY_PROVINCE=Bataan
DEFAULT_LATITUDE=14.6763
DEFAULT_LONGITUDE=120.5361
