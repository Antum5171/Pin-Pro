{
  "entities": {
    "Report": {
      "title": "Report",
      "description": "Community incident report submitted by a resident in PinPro",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "residentId": { "type": "string" },
        "residentName": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "on_the_way", "arrived", "resolved"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "arrivedAt": { "type": "string", "format": "date-time" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "assignedOfficialId": { "type": "string" },
        "assignedOfficialName": { "type": "string" }
      },
      "required": ["title", "category", "description", "residentId", "status"]
    },
    "ReportEvent": {
      "title": "ReportEvent",
      "description": "Lifecycle event log entry for an incident report in PinPro",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["submitted", "accepted", "on_the_way", "location_update", "arrived", "resolved"]
        },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "required": ["reportId", "type", "actorId", "actorRole"]
    },
    "OfficialLocation": {
      "title": "OfficialLocation",
      "description": "Live GPS location record for a barangay official",
      "type": "object",
      "properties": {
        "officialId": { "type": "string" },
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "heading": { "type": "number" },
        "reportId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["officialId", "name", "lat", "lng"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app alert notification for residents or officials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "reportId": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "reportId", "message"]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Community incident reports"
    },
    "/report_events/{eventId}": {
      "schema": "ReportEvent",
      "description": "Audit trail log events"
    },
    "/official_locations/{officialId}": {
      "schema": "OfficialLocation",
      "description": "Live official locations"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-app notifications"
    }
  }
}
